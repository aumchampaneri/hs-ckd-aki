# pixi environments
.pixi/*
!.pixi/config.toml
scripts/cache/

# File types
# .svg are too large to commit
# .ipynb are too large to commit and only used locally
*.pkl
*.DS_Store
*.ipynb

# Large folders/files
# data/ is too large to commit - use 01a_download.py to create files
# scripts/cache/ has no need to commit
# > S2_Table_Targeted_DE.csv.gz is too large to commit
data/
scripts/cache/
outputs/qc/decontx_batches/

outputs/pseudobulk_de/reviewer_de_results_long.csv
outputs/pseudobulk_de/all_pseudobulk_de_results.csv

outputs/scvi/complement_scores_obs.parquet
outputs/scvi/violin_full_dataset_program_scores_by_disease.svg

supplementary_tables/S2_Table_Targeted_DE.csv.gz

# Plots - generated by 03b_pydeseq2-plot.py (easy to regenerate)
outputs/plots/pseudobulk_de
outputs/eGFR_correlation/

# Trajectory PDFs and SVGs
# > Contains redundant trajectory visualizations
outputs/trajectory/**/*.pdf
outputs/trajectory/**/*.svg
outputs/trajectory/**/*.tif

# Reference files
# > Contains original author manuscript and supplementary files (media-1->3
reference/*.pdf
reference/*.xlsx

# Miscellaneous folders/files
manuscript/figures/v1 figures/
.ipynb_checkpoints/
supplementary_tables/S5_Table.xlsx
